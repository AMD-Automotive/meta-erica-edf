+#define AMS_BYPASS_FPD_MASK        0x00040000U
+
+/**
+ * EAM (Error Aggregation Module) mask for FPD power cycle.
+ *
+ * When FPD rail is cut, APU PLLs lose lock and fire EAM errors
+ * 0x65/0x66 (APLL1/APLL2 lock-loss) on ERR0 bits 5-6.  These
+ * are expected hardware behavior (PLL has no power) but if left
+ * unmasked, PLM's EAM IRQ handler loops on them and can wedge
+ * the scheduler — preventing RTC GIC Proxy wake dispatch.
+ *
+ * Masked on PMC3 (IRQ routing group) before FPD power-off in
+ * XPm_PowerDwnFPD, unmasked in XPm_PowerUpFPD.
+ * PMC3 is the group routed to PLM's IRQ — confirmed by
+ * xplmi_err.c:1190: "PMC3_EAMx .. is routed to IRQ".
+ *
+ * Register layout (LPD_SLCR EAM, per PMC routing group):
+ *   MASK = base (read-only), EN = MASK+0x20, DIS = MASK+0x40
+ */
+#define EAM_PMC3_ERR0_MASK_REG    (LPD_SLCR_BASEADDR + 0x00040160U)
+#define EAM_EN_OFFSET             0x20U
+#define EAM_DIS_OFFSET            0x40U
+#define EAM_APLL_LOCK_LOSS_MASK   0x00000060U
+
 #define SYSMON_CHECK_POWER_TIMEOUT	2000000U
 
