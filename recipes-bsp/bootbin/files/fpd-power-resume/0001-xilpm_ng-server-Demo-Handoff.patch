 XStatus XPm_PowerDwnFPD(const XPm_Node *Node)
 {
 	XStatus Status = XST_FAILURE;
+	XStatus HasResumeAddrStatus = XST_FAILURE;
+	u32 DbgErr = (u32)XPM_INT_ERR_UNDEFINED;
 
-	/* TODO: Add Power down sequence for FPD */
-	(void)Node;
-	Status = XST_SUCCESS;
+	xil_printf("[FPD] Powering Down FPD\r\n");
+	/* Flush subsystem state before FPD power-off */
+	Status = XPmSubsystem_CmnFlush(PM_SUBSYS_DEFAULT);
+	if (XST_SUCCESS != Status) {
+		xil_printf("[FPD] Subsystem flush failed before FPD power down, rc=0x%x\r\n", Status);
+		goto done;
+	}
+
+	const XPm_Core *ApuCore = NULL;
+	const XPm_Device *AmsRoot = NULL;
+	const XPm_PsFpDomain *FpDomain = NULL;
+
+	AmsRoot = XPmDevice_GetById(PM_DEV_AMS_ROOT);
+	if (NULL == AmsRoot) {
+		DbgErr = (u32)XPM_INT_ERR_INVALID_DEVICE;
+		goto done;
+	}
+
+	/* Unlock configuration and system registers for write operation */
+	/* TODO: FIXME: AmsRoot object not populated in xilpm_ng */
+	// XPm_UnlockPcsr(AmsRoot->Node.BaseAddress);
+	PmOut32(AMS_ROOT_PCSR_LOCK, PCSR_UNLOCK_VAL);
+
+	// PmRmw32(AmsRoot->Node.BaseAddress + 0x00000104,
+	// 	0x00040000, 0x00040000);
+	PmRmw32(AMS_ROOT_TOKEN_MNGR,
+        AMS_BYPASS_FPD_MASK,
+        AMS_BYPASS_FPD_MASK);
+
+	/* Lock configuration and system registers */
+	// XPm_LockPcsr(AmsRoot->Node.BaseAddress);
+	PmOut32(AMS_ROOT_PCSR_LOCK, PCSR_LOCK_VAL);
+
+	/* disable CRL Write Protections */
+	PmOut32(PSX_CRL_BASEADDR + PSX_CRL_WPROT_OFFSET, 0U);
+	/* disable LPD SLCR Write Protections */
+	PmOut32(LPD_SLCR_BASEADDR, 0U);
+	/* disable CRP Write Protections */
+	PmOut32(CRP_BASEADDR + CRP_WPROT_OFFSET, 0U);
+
+	/**
+	 * Mask EAM errors that fire during FPD power cycle.
+	 * Must be AFTER LPD_SLCR write-protection disable — EAM
+	 * registers are in the LPD_SLCR address space (0xEB45xxxx).
+	 *
+	 * APLL lock-loss (ERR0 bits 5,6): APU PLLs lose lock when FPD
+	 * rail is cut.  If unmasked, PLM's EAM IRQ handler loops on
+	 * them and wedges the scheduler — RTC wake never dispatched.
+	 *
+	 * MMI correctable (ERR3 bits 10,12,13,15): MMI peripherals
+	 * post correctable events during CDO replay on resume.
+	 * Non-fatal but produces noisy log lines.
+	 *
+	 * Mask APLL lock-loss on PMC0 before cutting FPD rail.
+	 * Unmasked in XPm_PowerUpFPD after FPD is back.
+	 */
+	PmOut32(EAM_PMC3_ERR0_MASK_REG + EAM_DIS_OFFSET,
+		EAM_APLL_LOCK_LOSS_MASK);
+
+	/* Isolate: FPD-NOC */
+	Status = XPmDomainIso_Control((u32)XPM_NODEIDX_ISO_FPD_SOC, TRUE_VALUE);
+	if (XST_SUCCESS != Status) {
+		DbgErr = XPM_INT_ERR_PMC_PL_CFRAME_ISO;
+		goto done;
+	}
+
+	/* Isolate: FPD-LPD */
+	Status = XPmDomainIso_Control((u32)XPM_NODEIDX_ISO_LPD_FPD, TRUE_VALUE);
+	if (XST_SUCCESS != Status) {
+		DbgErr = XPM_INT_ERR_PMC_PL_CFRAME_ISO;
+		goto done;
+	}
+
+	/* Isolate: FPD-LPD_DFX */
+	Status = XPmDomainIso_Control((u32)XPM_NODEIDX_ISO_LPD_FPD_DFX, TRUE_VALUE);
+	if (XST_SUCCESS != Status) {
+		DbgErr = XPM_INT_ERR_PMC_PL_CFRAME_ISO;
+		goto done;
+	}
+
+	/* Isolate: FPD-PL */
+	Status = XPmDomainIso_Control((u32)XPM_NODEIDX_ISO_FPD_PL_TEST, TRUE_VALUE);
+	if (XST_SUCCESS != Status) {
+		DbgErr = XPM_INT_ERR_PMC_PL_CFRAME_ISO;
+		goto done;
+	}
+	
+	/* Isolate: FPD-PL_TEST */
+	Status = XPmDomainIso_Control((u32)XPM_NODEIDX_ISO_FPD_PL, TRUE_VALUE);
+	if (XST_SUCCESS != Status) {
+		DbgErr = XPM_INT_ERR_PMC_PL_CFRAME_ISO;
+		goto done;
+	}
+
+	/* Isolate: FPD-MMI */
+	/* TODO: FIXME: Missing */
+
+	/* Isolate: FPD-MMI_DFX */
+	/* TODO: FIXME: Missing */
+
+	/* TODO: FIXME: Following Reset Nodes are not present in Device Topology yet! */
+	// Status = PwrDomainRstAction(PM_RST_FPD_SRST, XPM_RST_STATE_ASSERTED);
+	// if (XST_SUCCESS != Status) {
+	// 	DbgErr = XPM_INT_ERR_RST_RELEASE;
+	// 	goto done;
+	// }
+	// Status = PwrDomainRstAction(PM_RST_FPD_POR, XPM_RST_STATE_ASSERTED);
+	// if (XST_SUCCESS != Status) {
+	// 	DbgErr = XPM_INT_ERR_RST_RELEASE;
+	// 	goto done;
+	// }
+	/* PSX_CRL.RST_FPX: assert FPD SRST */
+	PmRmw32(0xEB5E03D0U, 0x2U, 0x2U);
+
+	/* set reset value for LPD SLCR Scan Clear Trigger */
+	PmOut32(PSXC_LPX_SLCR_SCAN_CLEAR_TRIGGER, 0U);
+
+	/* set reset value for LPD SCLR Mem Clear Trigger */
+	PmOut32(PSXC_LPX_SLCR_MEM_CLEAR_TRIGGER, 0U);
+
+	/* set reset value for CRP XDP Control */
+	/* TODO: FIXME: MACROs missing */
+	PmRmw32(CRP_BASEADDR + 0x100U, 0x3FF00U, 0x200U);
+
+	FpDomain = (XPm_PsFpDomain *)XPmPower_GetById(Node->Id);
+	if (NULL == FpDomain) {
+		Status = XPM_INVALID_PWRDOMAIN;
+		DbgErr = XPM_INT_ERR_INVALID_PWR_DOMAIN;
+		goto done;
+	}
+
+	/* Rail Update Status */
+	Status = XPmPower_UpdateDomainPower(&FpDomain->Domain, XPM_POWER_STATE_OFF);
+	if (XST_SUCCESS != Status) {
+		DbgErr = XPM_INT_ERR_FPD_RAIL_CONTROL;
+		goto done;
+	}
+	xil_printf("[FPD] GPIO FPD OFF done\r\n");
+
+	/* Enable GIC Proxy? */
+	ApuCore = (XPm_Core *)XPmDevice_GetById(PM_DEV_ACPU_0_0);
+	if (NULL != ApuCore) {
+		HasResumeAddrStatus = XPmCore_HasResumeAddr(ApuCore);
+		if (XST_SUCCESS == HasResumeAddrStatus) {
+			/* Enable GIC proxy only if resume path is set */
+			xil_printf("[FPD] Enabling GIC Proxy\r\n");
+			XPm_GicProxy.Enable();
+		}
+		else {
+			DbgErr = (u32)XPM_INT_ERR_INVALID_ADDR;
+		}
+	}
+
+done:
+	/* enable CRL Write Protections */
+	PmOut32(PSX_CRL_BASEADDR + PSX_CRL_WPROT_OFFSET, 1U);
+	/* enable LPD SLCR Write Protections */
+	PmOut32(LPD_SLCR_BASEADDR, 1U);
+	/* enable CRP Write Protections */
+	PmOut32(CRP_BASEADDR + CRP_WPROT_OFFSET, 1U);
 
 	return Status;
 }
