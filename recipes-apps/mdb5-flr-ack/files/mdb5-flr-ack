"""
mdb5-flr-ack - complete PCIe Function Level Resets on the Versal Gen 2 MMI
PCIe controller.

WHY THIS EXISTS
    The MMI PCIe controller does not finish an FLR by itself. When the host
    initiates one, the controller latches flr_pf_active for that function and
    holds the function in reset until software writes the matching
    app_flr_pf_done bit in FLR_COMPLETION_CTRL0. That register resets to zero,
    so with no handler running every FLR hangs forever: the function stops
    answering configuration reads (all-0xFF) and only a power cycle recovers it.

    Confirmed on RAVE2 ECP hardware, 2026-09-28:
      - with PF3 dead after an FLR, exactly PF3's flr_pf_active bit was set
        while PF0/PF1/PF2 read clean;
      - writing app_flr_pf_done bit 3 brought PF3 back with no reboot;
      - acknowledging during a live FLR made the host's reset return success
        instead of killing the function.

SCOPE - THIS IS A BRING-UP STOPGAP, NOT A PRODUCTION HANDLER
    The register documentation defines the acknowledgement as meaning "the
    application has completed initializing its data structures for the function
    and there are no more TLPs associated with this function in the
    application's transmit queue".

    This daemon does no such thing. It acknowledges immediately, without
    quiescing anything. That is sufficient to make a function survive a reset
    and to unblock PCIe passthrough assignment, but a production implementation
    must first tear down and reinitialise whatever the function owns - the
    camera proxy behind PF1, the safe-display path behind PF2, and so on -
    before acknowledging. Otherwise the host may re-probe a function whose
    endpoint-side state is still live from before the reset.

POLLING, NOT INTERRUPTS
    PFn_IR_ENABLE_MISC can route flr_pf_active to an interrupt, but nothing in
    this system has a kernel handler registered for it, and enabling it would
    risk an unhandled-IRQ storm. Polling at a few milliseconds is far inside the
    100 ms the PCIe spec allows a function to become ready, and costs nothing
    measurable.
"""

import argparse
import ctypes
import mmap
import os
import signal
import sys
import time

# --- MMI_PCIE_CTRL_SLCR register map (am028 Versal Gen 2 Register Reference) --
#
# Controller 0 is the one the RAVE2 ECP design uses (MMI_CONFIG(PCIE0_*)).
SLCR_BASE = {0: 0x00ED931000, 1: 0x00ED939000}
MAP_LEN = 0x2000  # covers 0x420..0x1043

# PFn_IR_*_MISC block, 0x14 stride:  PF0 0x420  PF1 0x434  PF2 0x448  PF3 0x45C
IR_STATUS_MISC = 0x420
IR_STRIDE = 0x14
FLR_PF_ACTIVE = 1 << 12  # bit 12, w1c in the STATUS register

# app_flr_pf_done[7:0] - one bit per physical function. Self-clearing: the
# controller consumes the write and the field reads back 0 once it has
# released the function.
FLR_COMPLETION_CTRL0 = 0x1040

MAX_PF = 8


class Slcr:
    """32-bit MMIO window onto an MMI_PCIE_CTRL_SLCR instance.

    Accesses go through a ctypes uint32 pointer rather than mmap slicing, so
    every read and write is a genuine aligned 32-bit load/store. Python's
    buffer slicing may lower to memcpy, which is not safe against device
    registers.
    """

    def __init__(self, base):
        if base % mmap.PAGESIZE:
            raise ValueError(f"base 0x{base:X} is not page aligned")
        self._fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
        self._map = mmap.mmap(
            self._fd,
            MAP_LEN,
            mmap.MAP_SHARED,
            mmap.PROT_READ | mmap.PROT_WRITE,
            offset=base,
        )
        self._addr = ctypes.addressof(ctypes.c_char.from_buffer(self._map))

    def _ptr(self, off):
        return ctypes.cast(self._addr + off, ctypes.POINTER(ctypes.c_uint32))

    def rd(self, off):
        return self._ptr(off)[0]

    def wr(self, off, val):
        self._ptr(off)[0] = val

    def close(self):
        # Drop the ctypes view before unmapping, or mmap.close() raises
        # BufferError for the still-exported buffer.
        self._addr = None
        self._map.close()
        os.close(self._fd)


def ir_status_off(pf):
    return IR_STATUS_MISC + pf * IR_STRIDE


def log(msg):
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}", flush=True)


def show_status(slcr, pfs):
    done = slcr.rd(FLR_COMPLETION_CTRL0)
    log(f"FLR_COMPLETION_CTRL0 = 0x{done:08x}")
    for pf in pfs:
        off = ir_status_off(pf)
        val = slcr.rd(off)
        active = "YES" if val & FLR_PF_ACTIVE else "no"
        log(f"PF{pf}_IR_STATUS_MISC (+0x{off:03x}) = 0x{val:08x}  flr_pf_active={active}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    ap.add_argument("--controller", type=int, default=0, choices=(0, 1),
                    help="MMI PCIe controller index (default 0)")
    ap.add_argument("--pfs", default="0,1,2,3",
                    help="comma-separated physical functions to service (default 0,1,2,3)")
    ap.add_argument("--interval", type=float, default=0.005,
                    help="poll interval in seconds (default 0.005)")
    ap.add_argument("--status", action="store_true",
                    help="print current FLR register state and exit")
    args = ap.parse_args()

    try:
        pfs = sorted({int(x) for x in args.pfs.split(",") if x.strip() != ""})
    except ValueError:
        sys.exit(f"bad --pfs value: {args.pfs!r}")
    if not pfs or pfs[0] < 0 or pfs[-1] >= MAX_PF:
        sys.exit(f"--pfs must be within 0..{MAX_PF - 1}")

    base = SLCR_BASE[args.controller]
    try:
        slcr = Slcr(base)
    except PermissionError:
        sys.exit("need root for /dev/mem")
    except OSError as e:
        sys.exit(f"cannot map MMI_PCIE{args.controller}_CTRL_SLCR at 0x{base:X}: {e}")

    if args.status:
        show_status(slcr, pfs)
        slcr.close()
        return 0

    running = True

    def stop(signum, _frame):
        nonlocal running
        running = False
        log(f"caught signal {signum}, exiting")

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    log(f"watching MMI_PCIE{args.controller}_CTRL_SLCR @ 0x{base:X}, "
        f"PFs {','.join(map(str, pfs))}, poll {args.interval * 1000:.1f} ms")

    # An FLR that was already outstanding when we started would otherwise sit
    # there until the next one; report it so a stuck function at boot is
    # visible in the journal rather than silently swallowed.
    stuck = [pf for pf in pfs if slcr.rd(ir_status_off(pf)) & FLR_PF_ACTIVE]
    if stuck:
        log(f"FLR already pending at startup on PF{','.join(map(str, stuck))} "
            f"- acknowledging now")

    handled = 0
    try:
        while running:
            # Collect every function that is currently in FLR and acknowledge
            # them in one write. app_flr_pf_done self-clears, so acknowledging
            # one function at a time could drop a concurrent one's bit.
            pending = 0
            for pf in pfs:
                if slcr.rd(ir_status_off(pf)) & FLR_PF_ACTIVE:
                    pending |= 1 << pf

            if pending:
                slcr.wr(FLR_COMPLETION_CTRL0, pending)
                for pf in pfs:
                    if pending & (1 << pf):
                        # Latched status: does NOT self-clear. Without this the
                        # next poll sees a stale event and re-acknowledges.
                        slcr.wr(ir_status_off(pf), FLR_PF_ACTIVE)
                        handled += 1
                        log(f"PF{pf}: FLR acknowledged (app_flr_pf_done bit {pf})")

            time.sleep(args.interval)
    finally:
        log(f"stopping after handling {handled} FLR event(s)")
        slcr.close()

    return 0


if __name__ == "__main__":
    sys.exit(main())
