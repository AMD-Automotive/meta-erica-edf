[Unit]
Description=RAVE2 PCIe OSPI/SDA Programming Service
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/sbin/programmer
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
