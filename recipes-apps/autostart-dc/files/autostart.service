[Unit]
Description=Boot script for misc init tasks

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/autostart-dc.sh
# Gracefully kills only the specific tmux session on stop
ExecStop=/usr/bin/tmux kill-session -t ep_proxy
RemainAfterExit=yes
KillMode=process

[Install]
WantedBy=multi-user.target
