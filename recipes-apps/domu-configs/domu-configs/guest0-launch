echo "Mounting guest fat partition and copying Linux kernel"
mkdir -p /root/xenmount
mount /dev/sda3 /root/xenmount
cp /root/xenmount/Image /root
umount /root/xenmount
rm -rf /root/xenmount
echo "done - launching guest"

xl create -c /etc/xen/guest0.cfg


