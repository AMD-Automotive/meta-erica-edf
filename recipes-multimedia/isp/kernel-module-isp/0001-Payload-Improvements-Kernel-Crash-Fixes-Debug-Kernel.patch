 		dev_err(isp_dev->dev,
 			"port %d chn %d open sensor failed, ret is %d", port,
@@ -1605,7 +1619,11 @@ int media_isp_device_camera_connect(struct visp_dev *isp_dev, uint8_t index)
 	}
 
 	if (isp_dev->ports_mask != 0x01) {
+		t_mark = ktime_get();
 		ret_val = media_isp_device_mcm_init(isp_dev, port);
+		dev_info(isp_dev->dev,
+			 "[TIMING]   mcm_init took %lld ms\n",
+			 ktime_ms_delta(ktime_get(), t_mark));
 		if (ret_val != VSI_SUCCESS) {
 			dev_err(isp_dev->dev,
 				" port %d chn %d init mcm failed, ret is %d",
@@ -1616,8 +1634,12 @@ int media_isp_device_camera_connect(struct visp_dev *isp_dev, uint8_t index)
 
 	memset(&sub_module_init, 0, sizeof(sub_module_init));
 
