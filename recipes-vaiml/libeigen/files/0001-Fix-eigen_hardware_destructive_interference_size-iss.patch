From 032ee61b1c4cd228349646c7a15603a880722b2d Mon Sep 17 00:00:00 2001
From: Nani Annam <nania@amd.com>
Date: Tue, 18 Feb 2025 12:05:28 +0530
Subject: [PATCH] Fix eigen_hardware_destructive_interference_size issue

---
 Eigen/src/Core/util/ConfigureVectorization.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Eigen/src/Core/util/ConfigureVectorization.h b/Eigen/src/Core/util/ConfigureVectorization.h
index 47ddd4f8a..5e9f9a337 100644
--- a/Eigen/src/Core/util/ConfigureVectorization.h
+++ b/Eigen/src/Core/util/ConfigureVectorization.h
@@ -41,7 +41,8 @@
 // Align to the boundary that avoids false sharing.
 // https://en.cppreference.com/w/cpp/thread/hardware_destructive_interference_size
 #ifdef __cpp_lib_hardware_interference_size
-#define EIGEN_ALIGN_TO_AVOID_FALSE_SHARING EIGEN_ALIGN_TO_BOUNDARY(std::hardware_destructive_interference_size)
+//#define EIGEN_ALIGN_TO_AVOID_FALSE_SHARING EIGEN_ALIGN_TO_BOUNDARY(std::hardware_destructive_interference_size)
+#define EIGEN_ALIGN_TO_AVOID_FALSE_SHARING EIGEN_ALIGN_TO_BOUNDARY(16)
 #else
 // Overalign for the cache line size of 128 bytes (Apple M1)
 #define EIGEN_ALIGN_TO_AVOID_FALSE_SHARING EIGEN_ALIGN_TO_BOUNDARY(128)
-- 
2.34.1

